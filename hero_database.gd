extends RefCounted

# Offline, Grade 6-readable summaries. Portrait paths remain empty until
# approved licensed chibi artwork is supplied.
const HEROES: Array[Dictionary] = [
	{"hero_id":"lapulapu","hero_name":"Lapulapu","associated_level":1,"educational_theme":"Defense of Mactan","short_biography":"A leader of Mactan who defended his community from Ferdinand Magellan's expedition in 1521.","contribution":"Led the defense of Mactan and resisted foreign control.","contribution_year":"27 April 1521","death_date":"Unknown","cause_of_death":"Unknown - surviving reliable records do not document when or how Lapulapu died.","historical_legacy":"Remembered as an early symbol of courage, independence, and resistance to foreign rule.","story_text":"Lapulapu was one of the leaders of Mactan. On 27 April 1521, he and the warriors of Mactan defended their community against the expedition led by Ferdinand Magellan. Lapulapu refused to accept the foreign authority claimed by the expedition. His forces won the Battle of Mactan, where Magellan was killed. Reliable surviving records do not establish the date or cause of Lapulapu's death, so these details remain unknown. Filipinos remember him as an early symbol of courage, independence, and resistance to foreign control.","portrait_path":"","references":["https://philhistoricsites.nhcp.gov.ph/registry_database/lapulapu-2/"]},
	{"hero_id":"andres_bonifacio","hero_name":"Andres Bonifacio y de Castro","associated_level":2,"educational_theme":"Katipunan and Revolution","short_biography":"Founder and Supremo of the Katipunan who helped begin the Philippine Revolution.","contribution":"Founded the Katipunan in 1892 and led the opening of the Revolution in 1896.","contribution_year":"7 July 1892 and August 1896","death_date":"10 May 1897","cause_of_death":"Executed by shooting at Mount Buntis after a military trial.","historical_legacy":"Remembered as the Supremo and Father of the Philippine Revolution.","story_text":"Andres Bonifacio y de Castro helped found the Katipunan on 7 July 1892. The movement sought Philippine independence from Spain. As Supremo, he encouraged Filipinos to unite and helped begin the wider Revolution in August 1896. After disagreements within the revolutionary movement, Bonifacio and his brother Procopio were tried by a military court. They were executed by shooting at Mount Buntis on 10 May 1897. His death was an execution, not an illness or natural death. Bonifacio is remembered as the Father of the Philippine Revolution and as a leader who organized ordinary people for freedom.","portrait_path":"","references":["https://philhistoricsites.nhcp.gov.ph/registry_database/andres-bonifacio-30-nobyembre-1863-10-mayo-1897/"]},
	{"hero_id":"jose_rizal","hero_name":"Jose Rizal y Mercado","associated_level":3,"educational_theme":"Reform and Nationalism","short_biography":"Physician, writer, reform advocate, and patriot whose works strengthened Filipino nationalism.","contribution":"Exposed colonial abuses through Noli Me Tangere and El Filibusterismo.","contribution_year":"1887 and 1891","death_date":"30 December 1896","cause_of_death":"Executed by firing squad at Bagumbayan, Manila.","historical_legacy":"His writings and martyrdom strengthened Filipino nationhood.","story_text":"Jose Rizal y Mercado was a physician, writer, educator, and reform advocate. Noli Me Tangere, published in 1887, and El Filibusterismo, published in 1891, described abuses under Spanish colonial rule. Rizal called for peaceful reform and equal treatment. Spanish authorities executed him by firing squad at Bagumbayan on 30 December 1896. His death was an execution, not a natural death. His writings and sacrifice strengthened Filipino nationhood and showed how education and responsible writing can help a nation seek justice.","portrait_path":"","references":["https://philhistoricsites.nhcp.gov.ph/registry_database/jose-rizal-1861-1896/"]},
	{"hero_id":"antonio_luna","hero_name":"Antonio Luna","associated_level":4,"educational_theme":"Military Leadership","short_biography":"A scientist, writer, and general who organized the army of the First Philippine Republic.","contribution":"Founded the Academia Militar and served as chief commander of the Republic's army.","contribution_year":"1898-1899","death_date":"5 June 1899","cause_of_death":"Killed in Cabanatuan, Nueva Ecija.","historical_legacy":"Remembered for discipline, military organization, and defense of the Philippine Republic.","story_text":"Antonio Luna was born in Manila on 29 October 1866. He earned a doctorate in pharmacy in Madrid and wrote for La Solidaridad. In 1898 he founded La Independencia and the Academia Militar. In February 1899, he became chief commander of the army of the Philippine Republic. Luna worked to build a disciplined force during the Filipino-American War. He was killed in Cabanatuan, Nueva Ecija, on 5 June 1899. His death was a violent killing, not an illness or natural death. He is remembered for military organization, discipline, scientific learning, and service to the Republic.","portrait_path":"","references":["https://philhistoricsites.nhcp.gov.ph/registry_database/antonio-luna-1866-1899/"]},
	{"hero_id":"melchora_aquino","hero_name":"Melchora Aquino de Ramos","associated_level":5,"educational_theme":"Mother of the Revolution","short_biography":"Known as Tandang Sora, she fed Katipuneros and cared for wounded revolutionaries.","contribution":"Supported the Katipunan by providing food, shelter, and care for the wounded.","contribution_year":"1896","death_date":"20 February 1919","cause_of_death":"The cited NHCP marker records her death but does not state a medical cause.","historical_legacy":"Honored as the Mother of the Philippine Revolution for her courage and care.","story_text":"Melchora Aquino de Ramos, known as Tandang Sora, was born in Banlat on 6 January 1812. During the Revolution in 1896, she gave food to Katipuneros led by Andres Bonifacio and cared for wounded revolutionaries. Spanish authorities arrested her and exiled her to Guam. She returned to the Philippines in 1903. She died on 20 February 1919. The cited NHCP marker does not state a medical cause, so it is not presented as known. She is honored as the Mother of the Philippine Revolution because her courage, generosity, and care supported people fighting for freedom.","portrait_path":"","references":["https://philhistoricsites.nhcp.gov.ph/registry_database/melchora-aquino-tandang-sora/"]},
	{"hero_id":"apolinario_mabini","hero_name":"Apolinario Mabini y Maranan","associated_level":6,"educational_theme":"Political Thought and Government","short_biography":"A lawyer, political thinker, chief adviser, and prime minister of the First Philippine Republic.","contribution":"Wrote important political documents and served as chief adviser and prime minister.","contribution_year":"1898-1899","death_date":"13 May 1903","cause_of_death":"Died of cholera in Manila.","historical_legacy":"Remembered as a principled political thinker and the Brains of the Revolution.","story_text":"Apolinario Mabini y Maranan was born in Tanauan, Batangas, on 23 July 1864. He studied law and wrote important political works. In 1898 he became a chief adviser to Emilio Aguinaldo. In 1899 he served as prime minister and secretary of foreign affairs of the First Philippine Republic. American authorities later exiled him to Guam. He returned in February 1903 and refused a post in the colonial government. Mabini died of cholera in Manila on 13 May 1903. He is remembered as a principled political thinker whose writing and public service helped guide the young Republic.","portrait_path":"","references":["https://philhistoricsites.nhcp.gov.ph/registry_database/apolinario-mabini-national-monument/","https://philhistoricsites.nhcp.gov.ph/registry_database/dating-libingan-ni-apolinario-mabini-1903/"]},
]

static func get_hero(hero_id: String) -> Dictionary:
	for hero: Dictionary in HEROES:
		if str(hero.get("hero_id", "")) == hero_id: return hero.duplicate(true)
	return {}

static func get_hero_for_level(level_id: int) -> Dictionary:
	for hero: Dictionary in HEROES:
		if int(hero.get("associated_level", 0)) == level_id: return hero.duplicate(true)
	return {}

static func get_heroes() -> Array: return HEROES.duplicate(true)
