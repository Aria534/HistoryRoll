[node name="Instructions" type="Label" parent="UIRoot/HelpOverlay/Panel/Margin/Content" unique_id=908964260]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.08, 0.14, 0.2, 1)
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 22
text = "1. Answer the multiple-choice question first.
2. Earn 10 points for a correct answer.
3. Lose 2 points for a wrong answer. Your score never goes below zero.
4. Roll the dice after answering.
5. Move your hero by the number shown on the dice.
6. Ladders move you forward.
7. Snakes move you backward.
8. A shield protects you from one snake.
9. Bonus Tiles give additional points.
10. Reach the final tile with an exact dice roll.
11. Complete the level to unlock the next one."
vertical_alignment = 1
autowrap_mode = 2

