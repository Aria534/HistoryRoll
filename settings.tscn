theme_override_font_sizes/font_size = 24
text = "1. A multiple-choice question appears first.\n2. Answer the question before rolling the dice.\n3. A correct answer gives +10 points.\n4. A wrong answer deducts 2 points, but never below zero.\n5. Roll the dice after answering.\n6. Move your Filipino hero by the dice result.\n7. Ladders move you forward.\n8. Snakes move you backward unless you have a shield.\n9. One shield protects you from one snake.\n10. Bonus Tiles award additional points.\n11. Reach the final tile with an exact dice roll.\n12. Complete a level to unlock the next level."
vertical_alignment = 1
autowrap_mode = 2

